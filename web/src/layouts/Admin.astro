---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource/montserrat/300.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/theme.css';
import { ClientRouter } from 'astro:transitions';
import Topbar from '../components/Topbar.astro';
import Sidebar from '../components/Sidebar.astro';
import { icon } from '../lib/icons';

interface Props {
  title: string;      // <title>
  mega: string;       // giant hero heading, e.g. "USERS."
  sub?: string;
  page: string;       // page module key (see lib/app.ts)
  perm?: string;      // permission required to view the page
  tall?: boolean;     // tall hero (dashboard)
  wide?: boolean;     // no context column
}
const { title, mega, sub, page, perm, tall = false, wide = false } = Astro.props;
const DEMO = import.meta.env.PUBLIC_TEMS_DEMO !== 'false';
const words = mega.split(' ');

const ease = 'cubic-bezier(.16,1,.3,1)';
const rise = {
  forwards:  { old: { name: 'vt-out', duration: '180ms', easing: 'ease-in', fillMode: 'both' }, new: { name: 'vt-in', duration: '560ms', easing: ease, fillMode: 'both', delay: '40ms' } },
  backwards: { old: { name: 'vt-out', duration: '180ms', easing: 'ease-in', fillMode: 'both' }, new: { name: 'vt-in', duration: '560ms', easing: ease, fillMode: 'both', delay: '40ms' } },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#2d0d60" />
    <title>{title} · Techzaz EMS</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <script is:inline>
      // Apply the saved light/dark theme before first paint (and after every view transition).
      (function () {
        function apply() { try { var t = localStorage.getItem('tems-theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {} }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div class="canvas" transition:persist="canvas" aria-hidden="true"><div class="glow-2"></div></div>

    <Topbar />

    <section class:list={['hero', { tall }]} transition:animate="fade">
      <slot name="hero" />
      <h1 class="mega">
        {words.map((w, i) => (<><span class="w"><span style={`animation-delay:${120 + i * 95}ms`}>{w}</span></span>{i < words.length - 1 ? ' ' : ''}</>))}
      </h1>
      {sub && <p class="hero-sub">{sub}</p>}
      <slot name="hero-actions" />
    </section>

    <div class="shell">
      <Sidebar />
      <div class:list={['content', { wide }]} transition:animate={rise}>
        {DEMO && (
          <div class="notice" role="note">
            <Fragment set:html={icon('info')} />
            <span>Techzaz EMS is running on <b>built-in demo data</b>: every change, audit entry and notification email is simulated in your browser. <button id="demoReset" class="linklike" style="background:none;border:0;padding:0;font-weight:700;text-decoration:underline;color:inherit">Reset demo data</button></span>
          </div>
        )}
        <main class="main" id="page" data-page={page} data-perm={perm}>
          <slot />
        </main>
        {!wide && <aside class="context" id="ctx" aria-label="On this page"><slot name="context" /></aside>}
      </div>
    </div>

    <footer class="foot">
      <span>© {new Date().getFullYear()} Techzaz Networks · Information is power.</span>
      <span>Techzaz EMS · Keycloak · Go · Astro</span>
    </footer>

    <div class="toasts" transition:persist="toasts" aria-live="polite"></div>

    <script>
      import '../lib/app';
    </script>
  </body>
</html>
